# No credentials needed for the local SQLite demo (Node 24+).
DATA_BACKEND=sqlite
SQLITE_PATH=.data/parkhawk.sqlite
# For hosted deployments use Supabase and run the migration first.
# DATA_BACKEND=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only set this to true in a disposable Supabase demo project.
ALLOW_DEMO_SEED=false
